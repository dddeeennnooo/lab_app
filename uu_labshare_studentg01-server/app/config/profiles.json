      "reservation/get": {
        "sysStateList": ["active", "restricted", "readOnly"],
        "profileList": ["Readers", "Executives", "Authorities", "AwidLicenseOwner"]
      },
      "reservation/list": {
        "sysStateList": ["active", "restricted", "readOnly"],
        "profileList": ["Readers", "Executives", "Authorities", "AwidLicenseOwner"]
